include<stdio.h>
#include<string.h>
#include<conio.h>

/* ---------- Error detection : CRC ---------- */
void crc()
{
    char data[50], gen[20], temp[70], code[70];
    int dl, gl, i, j, bad;

    printf("\nEnter the data bits      : ");
    scanf("%s", data);
    printf("Enter the generator      : ");
    scanf("%s", gen);
    dl = strlen(data);
    gl = strlen(gen);

    strcpy(temp, data);
    for (i = 0; i < gl - 1; i++)
        temp[dl + i] = '0';
    temp[dl + gl - 1] = '\0';

    for (i = 0; i < dl; i++)
        if (temp[i] == '1')
            for (j = 0; j < gl; j++)
                temp[i + j] = (temp[i + j] == gen[j]) ? '0' : '1';

    strcpy(code, data);
    strcat(code, temp + dl);
    printf("CRC (remainder)          : %s\n", temp + dl);
    printf("Transmitted code word    : %s\n", code);

    printf("\nEnter the received word  : ");
    scanf("%s", temp);
    for (i = 0; i < dl; i++)
        if (temp[i] == '1')
            for (j = 0; j < gl; j++)
                temp[i + j] = (temp[i + j] == gen[j]) ? '0' : '1';

    bad = 0;
    for (i = dl; i < dl + gl - 1; i++)
        if (temp[i] == '1')
            bad = 1;
    if (bad)
        printf("Remainder is non-zero : ERROR detected in received word\n");
    else
        printf("Remainder is zero     : NO ERROR in received word\n");
}

/* ---------- Error correction : Hamming (7,4) ---------- */
void hamming()
{
    int d[8], r[8], p1, p2, p4, pos, i;
    /* positions 1..7 : p1 p2 d3 p4 d5 d6 d7 */

    printf("\nEnter 4 data bits (d3 d5 d6 d7): ");
    scanf("%d%d%d%d", &d[3], &d[5], &d[6], &d[7]);

    d[1] = d[3] ^ d[5] ^ d[7];
    d[2] = d[3] ^ d[6] ^ d[7];
    d[4] = d[5] ^ d[6] ^ d[7];

    printf("Hamming code word        : ");
    for (i = 1; i <= 7; i++)
        printf("%d", d[i]);
    printf("\n");

    printf("\nEnter received 7 bits    : ");
    for (i = 1; i <= 7; i++)
        scanf("%d", &r[i]);

    p1 = r[1] ^ r[3] ^ r[5] ^ r[7];
    p2 = r[2] ^ r[3] ^ r[6] ^ r[7];
    p4 = r[4] ^ r[5] ^ r[6] ^ r[7];
    pos = p4 * 4 + p2 * 2 + p1;

    if (pos == 0)
        printf("No error in received code word\n");
    else
    {
        printf("Error found at bit position %d\n", pos);
        r[pos] = r[pos] ^ 1;
        printf("Corrected code word      : ");
        for (i = 1; i <= 7; i++)
            printf("%d", r[i]);
        printf("\n");
    }
}

